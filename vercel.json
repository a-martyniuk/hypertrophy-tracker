{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/hypertrophyracker/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/hypertrophyracker/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/hypertrophyracker/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/hypertrophyracker/favicon-32x32.png",
      "destination": "/favicon-32x32.png"
    },
    {
      "source": "/hypertrophyracker/favicon-16x16.png",
      "destination": "/favicon-16x16.png"
    },
    {
      "source": "/hypertrophyracker/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/hypertrophyracker/mask-icon.svg",
      "destination": "/mask-icon.svg"
    },
    {
      "source": "/hypertrophyracker/pwa-192x192.png",
      "destination": "/pwa-192x192.png"
    },
    {
      "source": "/hypertrophyracker/pwa-512x512.png",
      "destination": "/pwa-512x512.png"
    },
    {
      "source": "/hypertrophyracker/pwa-icon.svg",
      "destination": "/pwa-icon.svg"
    },
    {
      "source": "/hypertrophyracker/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/hypertrophyracker/registerSW.js",
      "destination": "/registerSW.js"
    },
    {
      "source": "/hypertrophyracker/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/hypertrophyracker/workbox-:match*",
      "destination": "/workbox-:match*"
    },
    {
      "source": "/hypertrophyracker/:match*",
      "destination": "/index.html"
    },
    {
      "source": "/hypertrophyracker",
      "destination": "/index.html"
    },
    {
      "source": "/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
